# memhub ingest-api 镜像（离线可构建）
# 构建：docker build --network=none -f deploy/Dockerfile.ingest -t memhub/app:0.1.0 .
# 前置：deploy/dist/wheelhouse-ingest/ 里有 memhub wheel 与全部依赖 wheel。
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/var/lib/memhub/home

WORKDIR /app
COPY deploy/dist/wheelhouse-ingest /wheelhouse
RUN pip install --no-index --find-links=/wheelhouse "memhub[postgres]==0.1.0"

# 与主机上的 memhub 系统用户一致；uid/gid 不在镜像 passwd 里也没关系（HOME 已显式设置）。
USER 999:987
EXPOSE 8700

# 绑定地址由 `memhub api` 从 MEMHUB_HTTP_HOST 读取，缺省 127.0.0.1；
# 非回环地址需显式 --allow-non-loopback，防止 host 网络下误绑 0.0.0.0。
CMD ["memhub", "api"]
