# memhub 服务端配置模板
# 只放键名与安全默认；真实值写入 .env（已忽略）。键集定义见 docs/tech/ENVIRONMENT.md §2。

MEMHUB_ENV=dev
MEMHUB_LOG_LEVEL=INFO

MEMHUB_DATA_DIR=./data
MEMHUB_KNOWLEDGE_DIR=./knowledge
# 运行态库（PostgreSQL）；留空时 ingest 用内存实现（仅 dev）。
# 生产示例：postgresql://memhub_app@127.0.0.1:5432/memhub_prod
MEMHUB_DB_URL=

MEMHUB_HTTP_HOST=127.0.0.1
MEMHUB_HTTP_PORT=8700

MEMHUB_LLM_BASE_URL=
MEMHUB_LLM_API_KEY=
MEMHUB_LLM_MODEL_FILTER=
MEMHUB_LLM_MODEL_EXTRACT=

MEMHUB_DEVICE_TOKEN_SECRET=
# prod 必填：/devices/register 必须带 Bearer <provision_token>（关闭开放注册）
MEMHUB_PROVISION_TOKEN=
MEMHUB_DEV_TOKEN=

MEMHUB_QUEUE_MAX_BYTES=1073741824
# processed_raw/ 是 raw_store 的完整副本，不受上面的配额约束；purge timer 按此总量裁剪
MEMHUB_PROCESSED_MAX_BYTES=2147483648
MEMHUB_DISK_WARN_PCT=80
MEMHUB_GIT_REMOTE=

# 本地管理台 kb-api（memhub kb）
MEMHUB_KB_GRAPH=kb/kg.json
# 留空则只提供 API，不托管前端
MEMHUB_KB_WEB_DIST=web/dist
# 写操作后 1.5s 防抖重建投影；0/off/false 关闭
MEMHUB_KB_AUTO_REBUILD=1
# 设置后由 kb-api 托管 explorer 子进程并在重建后重启它；留空则不自启
MEMHUB_KB_GRAPH_PORT=
