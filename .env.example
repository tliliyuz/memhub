# memhub 服务端配置模板
# 只放键名与安全默认；真实值写入 .env（已忽略）。键集定义见 docs/tech/ENVIRONMENT.md §2。

MEMHUB_ENV=dev
MEMHUB_LOG_LEVEL=INFO

# dev 本地正文目录（content_store）与 MCP spool 兜底；生产正文在 ClickHouse，不需要它
MEMHUB_DATA_DIR=./data
MEMHUB_KNOWLEDGE_DIR=./knowledge
# 运行态库（PostgreSQL）：队列（ingest_queue）、游标、批次幂等与设备都在这里。
# 生产必填（ingest / worker）；dev 留空时 ingest 用进程内实现。
# 生产示例：postgresql://memhub_app@127.0.0.1:5432/memhub_prod
MEMHUB_DB_URL=

# 正文存储（ClickHouse，ADR-0020）：原始增量写 memhub_raw.raw_sessions，
# 按 (project, sha256) 去重并保留 180 天。prod 必填；dev 留空时退回 $MEMHUB_DATA_DIR/content_store。
# MEMHUB_CH_CA 是可选的 CA 证书路径（自签/私有 CA 时用）。
MEMHUB_CH_URL=
MEMHUB_CH_USER=
MEMHUB_CH_PASSWORD=
MEMHUB_CH_CA=

# 知识真源库（PostgreSQL，ADR-0013）。四把键都与上面的 MEMHUB_DB_URL 分开：
# - MEMHUB_KB_DB_URL：kb-api / MCP 运行时角色 memhub_kb_app，只对 schema kb 下的 kb_* 有 DML
#   生产示例：postgresql://memhub_kb_app@127.0.0.1:5432/memhub_prod
# - MEMHUB_KB_RT_DB_URL：ingest / worker / CLI 运行时角色 memhub_rt_app（ADR-0021），
#   权限与上面一致但不与 kb-api 共用连接预算；缺失不回退 MEMHUB_KB_DB_URL
#   生产示例：postgresql://memhub_rt_app@127.0.0.1:5432/memhub_prod
# - MEMHUB_KB_MIGRATE_DB_URL：Alembic 迁移角色，对 kb_* 有 DDL；带外执行
# - MEMHUB_TEST_DB_URL：测试库（memhub_dev），未设置时 PG 用例跳过且不计为通过
MEMHUB_KB_DB_URL=
MEMHUB_KB_RT_DB_URL=
MEMHUB_KB_MIGRATE_DB_URL=
MEMHUB_TEST_DB_URL=

MEMHUB_HTTP_HOST=127.0.0.1
MEMHUB_HTTP_PORT=8700

MEMHUB_LLM_BASE_URL=
MEMHUB_LLM_API_KEY=
MEMHUB_LLM_MODEL_FILTER=
MEMHUB_LLM_MODEL_EXTRACT=
# 长期记忆聚合专用模型；留空回退 MEMHUB_LLM_MODEL_EXTRACT，两者都为空时 memory-aggregate 退出 2
MEMHUB_LLM_MODEL_MEMORY=
# 单次调用的输出预算（含 thinking）；太小会被思考吃光、拿不到正文
MEMHUB_LLM_MAX_TOKENS=32000
# --window 按哪个时区解释：空=系统本地（容器里是 UTC），生产用显式偏移
MEMHUB_WINDOW_TZ=+08:00

# 长期记忆注入（worker / ingest；规格 §7）
# 每次会话窗口最多注入的条目数，1–10
MEMHUB_MEMORY_TOP_K=8
# 记忆块字符预算，超过后按分数顺序截断
MEMHUB_MEMORY_INJECT_CHARS=4000
# 逗号分隔的库 id；命中的项目不注入记忆（不校验库是否存在）
MEMHUB_MEMORY_INJECT_DISABLED_PROJECTS=

MEMHUB_DEVICE_TOKEN_SECRET=
# prod 必填：/devices/register 必须带 Bearer <provision_token>（关闭开放注册）
MEMHUB_PROVISION_TOKEN=
MEMHUB_DEV_TOKEN=

# 队列上限：按 queued + processing 行的正文字节数求和；超限 ingest 返回 1008、管理台上传返回 1013
MEMHUB_QUEUE_MAX_BYTES=1073741824
# /ingest/projects 只读列表的上游：知识库列表走 kb-api（host 网络下同机回环）；建库只在管理台
MEMHUB_KB_API_URL=http://127.0.0.1:8701
# ingest 内部接口（/internal/enqueue、/internal/queue/{batch_id}）的 Bearer 凭据；
# 由 ingest 与 kb-api 两侧配置同一值，未配置时上传接口返回 503/2001
MEMHUB_INTERNAL_TOKEN=
# kb-api 调 ingest 内部接口的基址；与 MEMHUB_INTERNAL_TOKEN 同时配置才开放上传
MEMHUB_INGEST_URL=http://127.0.0.1:8700
MEMHUB_DISK_WARN_PCT=80
MEMHUB_GIT_REMOTE=

# 本地管理台 kb-api（memhub kb）
# 留空则只提供 API，不托管前端
MEMHUB_KB_WEB_DIST=web/dist
# MCP HTTP 入口（默认关闭）。JSON 数组，每项
# {sha256, scope: "mcp:read"|"mcp:write", expires_at: UTC 时间, projects: [库 id], name?}；
# mcp:write 隐含读，且只有它能看到并调用 kb_write_candidate。只填令牌的 SHA-256
# 摘要，原始令牌只进客户端凭据库。name 是展示名，缺省时界面显示摘要前 12 位。
# 留空 = /mcp 全部 404
MEMHUB_MCP_GRANTS=
# MCP 调用轨迹落库失败的兜底文件；留空则用 $MEMHUB_DATA_DIR/mcp_trace_spool.jsonl，
# 两者都没有时 spool 关闭（只记 ERROR 日志）
MEMHUB_KB_TRACE_SPOOL=
