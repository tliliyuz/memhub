# memhub 服务端配置模板
# 只放键名与安全默认；真实值写入 .env（已忽略）。键集定义见 docs/tech/ENVIRONMENT.md §2。

MEMHUB_ENV=dev
MEMHUB_LOG_LEVEL=INFO

MEMHUB_DATA_DIR=./data
MEMHUB_KNOWLEDGE_DIR=./knowledge
MEMHUB_DB_PATH=./data/memhub.db

MEMHUB_HTTP_HOST=127.0.0.1
MEMHUB_HTTP_PORT=8700

MEMHUB_LLM_BASE_URL=
MEMHUB_LLM_API_KEY=
MEMHUB_LLM_MODEL_FILTER=
MEMHUB_LLM_MODEL_EXTRACT=

MEMHUB_DEVICE_TOKEN_SECRET=

MEMHUB_QUEUE_MAX_BYTES=1073741824
MEMHUB_DISK_WARN_PCT=80
MEMHUB_GIT_REMOTE=